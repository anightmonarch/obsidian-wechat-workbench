{
  "name": "obsidian-wechat-workbench",
  "version": "0.1.0",
  "description": "A verifiable publishing workbench for WeChat Official Accounts.",
  "private": true,
  "type": "module",
  "main": "main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "verify:release": "node scripts/verify-release.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "sync:test-vault": "node scripts/sync-test-vault.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.15.17",
    "esbuild": "0.25.5",
    "eslint": "9.39.4",
    "eslint-plugin-obsidianmd": "0.4.1",
    "globals": "17.6.0",
    "jsdom": "29.0.0",
    "obsidian": "1.13.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.59.1",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "juice": "12.1.2",
    "postcss": "8.5.26",
    "postcss-selector-parser": "7.1.5",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  }
}
